# ==========================================
# SMART PLANT CARE PLATFORM CONFIGURATION
# ==========================================

# Server & Network
PORT=8000
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=production-grade-super-secret-key-change-in-prod-xyz-987654

# Database (Default: local SQLite; PostgreSQL for production cloud deployment)
# SQLite: sqlite:///./plant_care.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/plant_care_db
DATABASE_URL=sqlite:///./plant_care.db

# Edge / Device Security
REQUIRE_HMAC_AUTH=True
DEFAULT_DEVICE_ID=esp32-greenhouse-01
DEFAULT_API_KEY=plant-care-edge-token-2026-secure
DEFAULT_HMAC_SECRET=hmac-secret-key-plant-guard-99228811

# Watchdog & Dead-Man's Switch Parameters
HEARTBEAT_INTERVAL_SECONDS=10
DEADMAN_TIMEOUT_MULTIPLIER=2.5
MAX_PUMP_RUNTIME_SECONDS=8.0
DEFAULT_COOLDOWN_MINUTES=30

# Physics Simulator Configuration
SIMULATOR_BACKEND_URL=http://localhost:8000
SIMULATOR_TIME_ACCELERATION=60.0
SIMULATOR_NETWORK_DROPOUT_RATE=0.05
SIMULATOR_JITTER_MAX_SECONDS=0.4
